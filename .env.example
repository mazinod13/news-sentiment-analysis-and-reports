# cp .env.example .env    --  .env is gitignored.
# Only the MySQL settings are required. Every other variable has a working
# default; the full list is in the README, under "Configuration (environment)".

MYSQL_HOST=db.example.internal
MYSQL_PORT=3306
MYSQL_USER=news
MYSQL_PASSWORD=change-me
MYSQL_DB=news_sentiment
# disable | require | verify-ca | verify-full. Keep TLS on: without it, MySQL 8
# password login needs the `cryptography` package, left out to keep the image small.
MYSQL_SSLMODE=require

# The database must exist; the app creates its own tables:
#   CREATE DATABASE news_sentiment CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# API: 0.0.0.0 publishes it to the network, 127.0.0.1 keeps it on this machine.
# API_KEYS is empty = no key needed; set keys to require the X-API-Key header.
API_BIND=127.0.0.1
API_PORT=8000
API_KEYS=
