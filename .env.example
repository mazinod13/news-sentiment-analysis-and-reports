# Copy to .env and adjust.  .env is gitignored -- never commit it.
# cp .env.example .env
# Every variable is optional; the defaults below are what the app uses unset.

# --- Compose -----------------------------------------------------------------
# Project name namespaces containers and volumes. Change POSTGRES_PORT if 5433
# is already taken on this machine (it is bound to 127.0.0.1 only).
COMPOSE_PROJECT_NAME=news-sentiment
POSTGRES_PORT=5433

# --- Database ----------------------------------------------------------------
# Change the password for any deployment that is not a local machine.
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news_sentiment
# Only needed when running outside Docker; compose sets this itself.
# DATABASE_URL=postgresql+psycopg://news:news@localhost:5433/news_sentiment

# --- Scraper behaviour -------------------------------------------------------
# Identify honestly and give publishers a way to reach you.
USER_AGENT=NepalNewsSentiment/0.1 (+https://github.com/mazinod13/news-sentiment-analysis-and-reports)
REQUEST_TIMEOUT=20
# Seconds to wait between two requests to the same host.
PER_HOST_DELAY=1.0
MAX_RETRIES=3
RESPECT_ROBOTS=true
# Fetch the full article page for each new item (off = feed summary only).
FETCH_BODIES=true
# Cap on article bodies fetched per source per cycle. Keeps a first run polite.
MAX_BODIES_PER_RUN=25
# How many sources to poll concurrently (one thread each; per-host rate limits
# still apply inside each thread).
INGEST_CONCURRENCY=4

LOG_LEVEL=INFO

# --- Paths (rarely needed) ---------------------------------------------------
# SOURCES_DIR=config/sources
# SELECTORS_DIR=config/selectors
# CA_CERTS_DIR=certs
# Terms, weights and A-F thresholds for criticality grading.
# CRITICALITY_FILE=config/criticality.yaml
