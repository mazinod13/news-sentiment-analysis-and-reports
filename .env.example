# Copy to .env and fill in the database credentials.  .env is gitignored.
# cp .env.example .env
# Everything except the database has a working default.

# --- Your MySQL server (8.0+) -------------------------------------------------
# The app builds the connection URL from these and URL-escapes each part, so a
# password containing @ / : # works exactly as typed here -- no quoting needed.
MYSQL_HOST=db.example.internal
MYSQL_PORT=3306
MYSQL_USER=news
MYSQL_PASSWORD=change-me
MYSQL_DB=news_sentiment
#
# TLS: disable | require (encrypt, no certificate check) | verify-ca |
# verify-full (encrypt and verify certificate + hostname -- preferred).
# STRONGLY RECOMMENDED: MySQL 8 logs in with caching_sha2_password, which over
# an unencrypted connection needs the `cryptography` package that this image
# leaves out to stay small. Over TLS, no extra dependency is needed.
MYSQL_SSLMODE=require
# CA bundle for the verify-* modes, if the server uses a private CA.
# MYSQL_SSLROOTCERT=/app/certs/db-ca.pem
#
# The database must exist; the app creates its own tables. Create it as:
#   CREATE DATABASE news_sentiment CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Or give the whole URL and ignore everything above (escape it yourself):
# DATABASE_URL=mysql+pymysql://news:pass@db.example.internal:3306/news_sentiment?charset=utf8mb4

# --- Container ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=news-sentiment
# Resource ceiling for the worker container.
WORKER_MEMORY=512m
WORKER_CPUS=1.0
# Age at which the healthcheck calls the worker unhealthy, in seconds. One
# Ratopati-heavy cycle can legitimately take ~10 minutes.
# HEALTH_MAX_AGE=1800

# --- Scraper behaviour --------------------------------------------------------
# Identify honestly and give publishers a way to reach you.
USER_AGENT=NepalNewsSentiment/0.1 (+https://github.com/mazinod13/news-sentiment-analysis-and-reports)
REQUEST_TIMEOUT=20
# Seconds to wait between two requests to the same host.
PER_HOST_DELAY=1.0
MAX_RETRIES=3
RESPECT_ROBOTS=true
# Fetch the full article page for each new item (off = feed summary only).
FETCH_BODIES=true
# Cap on article bodies fetched per source per cycle. Keeps a first run polite.
MAX_BODIES_PER_RUN=25
# How many sources to poll concurrently (one thread each; per-host rate limits
# still apply inside each thread). Lower it on a 1-vCPU VM.
INGEST_CONCURRENCY=4

LOG_LEVEL=INFO

# --- Paths (rarely needed) ----------------------------------------------------
# SOURCES_DIR=config/sources
# SELECTORS_DIR=config/selectors
# CA_CERTS_DIR=certs
# Terms, weights and A-F thresholds for criticality grading.
# CRITICALITY_FILE=config/criticality.yaml
# HEARTBEAT_FILE=/tmp/news-worker.heartbeat
